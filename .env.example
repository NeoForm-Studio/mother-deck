# ─────────────────────────────────────────────────────────────────────────────
# MOTHER Deck (full Athena system) — environment template.
# Copy to  backend/.env.local  and fill in. NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core server ---
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3001

# --- Agent backend (build pipeline) ---
NEOFORM_MODEL=claude-cli/claude-opus-4-8
NEOFORM_TIMEOUT_S=7200
NEOFORM_RUNNER=on
SITE_TEMPLATE_PATH=../neoform-site-template

# --- Deploys / reporting / outreach (optional) ---
VERCEL_TOKEN=
VERCEL_SCOPE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_PARTNER_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ATHENA_REMOTE_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# CYBER DECK (MOTHER) — LOCAL SECURITY LAB ONLY.
# Use only against systems you own or are explicitly authorized to test.
# ─────────────────────────────────────────────────────────────────────────────

# Web terminal relay (xterm → shell). RCE by design; OFF unless set to 1, and
# always bound to localhost + per-run token even when enabled.
ATHENA_TERMINAL_ENABLED=0

# Kali WSL distro name used by the passive-recon aggregator.
KALI_DISTRO=kali-linux

# Passive OSINT — Shodan (free key: https://account.shodan.io). Read-only DB.
SHODAN_API_KEY=

# Isolated VirtualBox Kali lab VM (host-only network). All optional.
VM_NAME=
VM_HOST=192.168.56.10
VM_USER=kali
VM_PASS=
VM_HEADLESS=0
VBOXMANAGE=

# Local tutor model (Ollama) for the learn/ module.
TUTOR_QWEN_MODEL=
